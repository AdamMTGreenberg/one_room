# Template: replace User, paths and configuration; enable only after testing your adapter.
[Unit]
Description=OneRoom host runner for Alice
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=agent
WorkingDirectory=/opt/oneroom
ExecStart=/usr/bin/node /opt/oneroom/dist/runner.js /etc/oneroom/alice-runner.json
Restart=on-failure
RestartSec=5
KillMode=control-group
TimeoutStopSec=10
NoNewPrivileges=true
UMask=0077

[Install]
WantedBy=multi-user.target
