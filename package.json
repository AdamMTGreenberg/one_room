{
  "name": "oneroom",
  "version": "0.3.0",
  "description": "A self-hosted coordination room for agents: threads, status, PRs, tests and reliable host wake delivery.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "oneroom": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "smoke": "node test/smoke.mjs",
    "test": "npm run build && node --test test/regression.mjs test/collaboration.mjs test/github.mjs test/delivery.mjs && npm run smoke",
    "test:docker": "node test/docker.mjs",
    "credentials": "node dist/credentials.js",
    "backup": "node dist/backup.js",
    "runner": "node dist/runner.js",
    "test:scale": "node --max-old-space-size=96 test/scale.mjs",
    "test:browser": "node test/browser.mjs"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "better-sqlite3": "^11.10.0",
    "express": "^4.21.2",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^4.17.21",
    "@types/node": "^22.15.0",
    "playwright": "^1.63.0",
    "typescript": "^5.8.0"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
